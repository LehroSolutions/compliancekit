# APP_ENV accepts any value; only "development"/"dev" relax the checks below.
# Any other value (production, staging, a typo) makes the server REFUSE TO START if
# APP_PASS or AUTH_SALT are unset, empty, or still one of the known placeholders.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5101
APP_USER=admin
# Blocked outside development: admin123, empty, changeme, change-me-before-production, password
APP_PASS=change-me-before-production
APP_ROLE=admin
# Blocked outside development: compliancekit-salt, empty, changeme, change-me-before-production
AUTH_SALT=change-me-before-production
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
MAX_BODY_BYTES=1048576
# Maximum characters per scan, and the upper bound custom rule patterns run against.
MAX_SCAN_TEXT_CHARS=200000
# Maximum findings accepted by POST /api/ai/remediate in one request.
MAX_REMEDIATE_FINDINGS=200
# Explicit backend; initialization errors never switch stores.
APP_STORAGE=sqlite
# APP_DB_FILE=/persistent/path/data.sqlite
# APP_DATA_FILE=/persistent/path/data.json
